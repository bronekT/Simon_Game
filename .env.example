# ─────────────────────────────────────────────────────────────────────────────
# CLOSER — environment variables
#
# HOW TO USE:
#   1. Copy this file to ".env.local"  (that file is git-ignored, so your secrets
#      never get committed).
#   2. Fill in each value below by following the setup guide in README.md.
#   3. Restart `npm run dev` after any change here.
#
# For Vercel: add these same names/values under Project → Settings →
# Environment Variables (do NOT upload the file).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Phase 0) ---------------------------------------------------------
# From Supabase → your project → Project Settings → API.
# "Project URL"  -> NEXT_PUBLIC_SUPABASE_URL
# "anon public"  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# "service_role" -> SUPABASE_SERVICE_ROLE_KEY   (SECRET — server only, never shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App (Phase 0) --------------------------------------------------------------
# Local dev: http://localhost:3000
# Production: your Vercel URL, e.g. https://closer.vercel.app
APP_URL=http://localhost:3000

# --- Anthropic AI (added in Phase 1) -------------------------------------------
ANTHROPIC_API_KEY=

# --- Google OAuth (added in Phase 3) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Automation / cron (added in Phase 4–5) ------------------------------------
# Any long random string. The scheduled jobs (ingest, automations) must send it
# as a Bearer token; this keeps those endpoints private.
CRON_SECRET=
# The Gmail label your Plaud→Zapier flow drops transcript emails into.
CLOSER_GMAIL_LABEL=CLOSER
